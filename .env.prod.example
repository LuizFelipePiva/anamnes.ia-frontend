# =============================================
# .env.prod.example - variaveis usadas pelo docker-compose.prod.yml
# Copie para .env.prod e execute:
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# =============================================

# Frontend build args (Vite grava estes valores no bundle)
VITE_API_URL=https://seudominio.com/api
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Backend runtime
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_KEY=<anon-public-key>
SECRET_KEY=<gere-uma-chave-forte-com-pelo-menos-32-caracteres>
OPENAI_API_KEY=sk-proj-...
OPENAI_VECTOR_STORE_ID=vs_xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_EVAL=gpt-4o-mini

# CORS / URLs
ALLOWED_ORIGINS=https://seudominio.com
FRONTEND_URL=https://seudominio.com

# Email transacional (opcional, necessario para emails automaticos)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@seudominio.com

# Observabilidade Langfuse (opcional)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Ambiente
ENVIRONMENT=production
LOG_LEVEL=INFO
