# ===========================================
# ANAMNES.IA - Backend Environment Variables
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Supabase Configuration
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_chave_anon_do_supabase

# OpenAI Configuration
OPENAI_API_KEY=sk-sua_chave_da_openai
# ID da vector store com os PDFs médicos (OpenAI Platform > Storage > Vector Stores)
OPENAI_VECTOR_STORE_ID=vs_xxxxxxxxxxxxxxxx
# Modelo padrão (opcional — padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Modelo para avaliação SOAP (opcional — padrão: mesmo que OPENAI_MODEL)
OPENAI_MODEL_EVAL=gpt-4o-mini

# JWT Configuration
# IMPORTANTE: Use uma chave forte em produção (min. 32 caracteres)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=sua_chave_secreta_forte_aqui

# CORS Configuration (comma-separated URLs, no spaces)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-production-domain.com

# Database (Supabase PostgreSQL) - Opcional, só se usar conexão direta
DATABASE_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres

# Resend (envio de emails automáticos com credenciais temporárias)
# Crie sua conta em https://resend.com e verifique o domínio
RESEND_API_KEY=re_sua_chave_do_resend

# Email remetente (deve ser de um domínio verificado no Resend)
RESEND_FROM_EMAIL=noreply@seu-dominio.com

# Email de reply-to nos emails enviados (opcional — se omitido, não inclui reply-to)
REPLY_TO_EMAIL=suporte@seu-dominio.com

# URL do frontend (usada no botão do email de boas-vindas)
FRONTEND_URL=https://seu-dominio.com

# Langfuse (observabilidade e gestão de prompts)
# Crie sua conta em https://cloud.langfuse.com — plano grátis até 50K obs/mês
# Se não configurado, o app funciona normalmente sem rastreamento
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Environment (development | production)
# Em production: desativa Swagger/ReDoc e ativa headers de segurança extras
ENVIRONMENT=development

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
