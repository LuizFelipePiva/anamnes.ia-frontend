# ===========================================
# ANAMNES.IA - Frontend Environment Variables
# ===========================================
# Copie este arquivo para .env e preencha os valores

# API Backend URL (já inclui /api no final)
VITE_API_URL=http://localhost:8000/api

# Supabase Configuration (para queries diretas no frontend)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_do_supabase

# Host(s) permitidos no `vite preview` (comma-separated, ex: meu-app.onrender.com)
VITE_PREVIEW_HOST=
